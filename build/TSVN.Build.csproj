<?xml version="1.0" encoding="utf-8"?>
<!--
  Build harness for TSVN.VS2022.dll.

  The shipped TSVN.VS2022.csproj is a classic (non-SDK) VSIX project: it depends on
  Microsoft.VsSDK.targets and $(VSToolsPath) references that only Desktop MSBuild
  (devenv / Build Tools) can resolve, so `dotnet build` cannot load it.

  This SDK-style project compiles the exact same sources, XAML and command table with the
  .NET SDK CLI and emits a drop-in TSVN.VS2022.dll. Run build.cmd instead of invoking this
  project directly: it compiles the WinForms options dialog resources first.

  See README.md in this folder.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>TSVN.VS2022</AssemblyName>
    <RootNamespace>SamirBoulema.TSVN</RootNamespace>
    <OutputType>Library</OutputType>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <EnableDefaultItems>false</EnableDefaultItems>
    <DebugType>pdbonly</DebugType>
    <SignAssembly>false</SignAssembly>
    <Company>Samir Boulema</Company>
    <NoWarn>CS0618;MSB3277</NoWarn>
    <RepoRoot>$(MSBuildThisFileDirectory)..\</RepoRoot>
    <OptionsDialogResources>$(BaseIntermediateOutputPath)OptionsDialog.resources</OptionsDialogResources>
  </PropertyGroup>

  <!-- Same source set as TSVN.VS2022.csproj + TSVN.Shared.projitems -->
  <ItemGroup>
    <Compile Include="$(RepoRoot)TSVN.VS2022\Properties\AssemblyInfo.cs" />
    <Compile Include="$(RepoRoot)TSVN.VS2022\Properties\Settings.Designer.cs" />
    <Compile Include="$(RepoRoot)TSVN.VS2022\TSVN.cs" />
    <Compile Include="$(RepoRoot)TSVN.Shared\**\*.cs" />
  </ItemGroup>

  <!-- XAML: the Link keeps the original resource paths so the BAML keys stay identical -->
  <ItemGroup>
    <Page Include="$(RepoRoot)Resources\XAML\*.xaml">
      <Link>Resources\XAML\%(Filename)%(Extension)</Link>
    </Page>
    <Page Include="$(RepoRoot)TSVN.Shared\TSVNToolWindowControl.xaml">
      <Link>TSVNToolWindowControl.xaml</Link>
    </Page>
  </ItemGroup>

  <!-- WinForms options dialog: pre-compiled by build.cmd with the .NET Framework resgen.exe.
       The SDK build cannot process binary .resx entries (MSB3822/MSB3823). -->
  <ItemGroup>
    <EmbeddedResource Include="$(OptionsDialogResources)">
      <LogicalName>SamirBoulema.TSVN.Options.OptionsDialog.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Command table: VSCT.exe runs from Microsoft.VSSDK.BuildTools, Menus.ctmenu is embedded -->
  <ItemGroup>
    <VSCTCompile Include="$(RepoRoot)TSVN.VS2022\TSVN.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Design" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Transactions" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="UIAutomationTypes" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <!-- ExcludeAssets="runtime": the shipped dependencies are listed explicitly in package-vsix.py -->
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Community.VisualStudio.Toolkit.17" Version="17.0.527" />
    <PackageReference Include="Caliburn.Micro.Core" Version="4.0.230" />
    <PackageReference Include="Microsoft.ApplicationInsights" Version="2.22.0" />
    <!-- Ships VSCT.exe and Microsoft.VsSDK.targets, which wire VSCTCompile up -->
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2142">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Provides VSGlobals.vsct, required by the .vsct include list -->
    <PackageReference Include="Community.VisualStudio.VSCT" Version="16.0.29.6" />
  </ItemGroup>

  <Target Name="EnsureOptionsDialogResources" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(OptionsDialogResources)')"
           Text="$(OptionsDialogResources) is missing. Run build.cmd, which compiles TSVN.Shared\Options\OptionsDialog.resx with the .NET Framework resgen.exe." />
  </Target>

  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets"
          Condition="Exists('$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets')" />

</Project>
