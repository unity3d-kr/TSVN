      <!--File toolbar buttons.

          Each one is a command id of its own, not a second placement of the context menu
          command: visibility belongs to the command and applies everywhere it is placed, so
          sharing the id would take the context menu entry away with the toolbar button.

          DefaultInvisible and DynamicVisibility are what make the visibility constraint in
          the VisibilityConstraints section below take effect. Off by default, on when the
          user ticks the toolbar switch in TortoiseSVN > Windows > Options.-->
      <Button guid="guidTSVNCmdSet" id="toolbarShowLogCommand" priority="0x0100" type="Button">
        <Parent guid="guidTSVNCmdSet" id="fileHistoryToolbarGroup" />
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Icon guid="guidImages" id="showLog" />
        <Strings>
          <ButtonText>Show Log for File...</ButtonText>
        </Strings>
      </Button>

      <Button guid="guidTSVNCmdSet" id="toolbarBlameCommand" priority="0x0200" type="Button">
        <Parent guid="guidTSVNCmdSet" id="fileHistoryToolbarGroup" />
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Icon guid="guidImages" id="blame" />
        <Strings>
          <ButtonText>Blame...</ButtonText>
        </Strings>
      </Button>

      <Button guid="guidTSVNCmdSet" id="toolbarDifferencesCommand" priority="0x0300" type="Button">
        <Parent guid="guidTSVNCmdSet" id="fileHistoryToolbarGroup" />
