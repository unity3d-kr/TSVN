      <Button guid="guidTSVNCmdSet" id="toolbarUnlockCommand" priority="0x0200" type="Button">
        <Parent guid="guidTSVNCmdSet" id="fileLockToolbarGroup" />
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Icon guid="guidImages" id="unlock" />
        <Strings>
          <ButtonText>Release Lock</ButtonText>
        </Strings>
      </Button>
    </Buttons>

    <!--Menu icons-->
    <Bitmaps>
      <Bitmap 
		  guid="guidImages" 
		  href="../Resources/tsvn-menu-icons.png" 
		  usedList="showChanges, pull, push, showLog, revert, branch, merge, differences, blame, repo, resolve, sync, commit, disk, switchImage, cleanup, stash, fetch, add, properties, delete, shelve, lockImage, unlock, rename, unshelve, diffMarkers" />
    </Bitmaps>
  </Commands>

  <!-- Options is deliberately not placed in fourthContextMenuGroup: the file context menu is
       short and the dialog is reachable from TortoiseSVN > Windows in the main menu bar. -->

  <!--The file toolbar buttons are visible only while their own UI context is active.

      Visual Studio cannot hide a button that is already on a top level toolbar: it disables
      it instead. A visibility constraint is evaluated while the toolbar is built, so a
      command that carries one is simply not drawn until the context exists. ToolbarState
      raises and drops that context from %LOCALAPPDATA%\TSVN\toolbar.json, which is what makes
      "off by default, on when asked" work without a restart.-->
  <VisibilityConstraints>
    <VisibilityItem guid="guidTSVNCmdSet" id="toolbarShowLogCommand" context="guidTSVNFileToolbarContext" />
    <VisibilityItem guid="guidTSVNCmdSet" id="toolbarBlameCommand" context="guidTSVNFileToolbarContext" />
    <VisibilityItem guid="guidTSVNCmdSet" id="toolbarDifferencesCommand" context="guidTSVNFileToolbarContext" />
    <VisibilityItem guid="guidTSVNCmdSet" id="toolbarDiffPreviousCommand" context="guidTSVNFileToolbarContext" />
    <VisibilityItem guid="guidTSVNCmdSet" id="toolbarPropertiesCommand" context="guidTSVNFileToolbarContext" />
    <VisibilityItem guid="guidTSVNCmdSet" id="toolbarDiffMarkersCommand" context="guidTSVNFileToolbarContext" />
    <VisibilityItem guid="guidTSVNCmdSet" id="toolbarUpdateCommand" context="guidTSVNFileToolbarContext" />
    <VisibilityItem guid="guidTSVNCmdSet" id="toolbarCommitCommand" context="guidTSVNFileToolbarContext" />
    <VisibilityItem guid="guidTSVNCmdSet" id="toolbarRevertCommand" context="guidTSVNFileToolbarContext" />
    <VisibilityItem guid="guidTSVNCmdSet" id="toolbarAddCommand" context="guidTSVNFileToolbarContext" />
    <VisibilityItem guid="guidTSVNCmdSet" id="toolbarDeleteCommand" context="guidTSVNFileToolbarContext" />
    <VisibilityItem guid="guidTSVNCmdSet" id="toolbarRenameCommand" context="guidTSVNFileToolbarContext" />
    <VisibilityItem guid="guidTSVNCmdSet" id="toolbarLockCommand" context="guidTSVNFileToolbarContext" />
    <VisibilityItem guid="guidTSVNCmdSet" id="toolbarUnlockCommand" context="guidTSVNFileToolbarContext" />
  </VisibilityConstraints>

